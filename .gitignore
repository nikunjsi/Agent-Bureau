node_modules/
dist/
dist-package/
.tsbuildcache/
*.tsbuildinfo
native/*/build/
native/*/bin/
*.log
.env
.env.*
playwright-report/
test-results/
.DS_Store
Thumbs.db

# Engine config a test once wrote into the repo root with this machine's
# absolute paths in it (pre-M11 N-4). Tests now use a temp stateDir; this
# stops a regression from being committed again.
/mcp-config.json
/claude-settings.json

# Claude Code's local state (tool-permission cache, subagent worktrees) is
# session/tooling-specific, not project source. Project skills are the
# exception: they are shared instructions every session on this repo uses.
.claude/*
!.claude/skills/

# Generated output, never source. graphify's knowledge graph (15 MB, rebuilt
# on demand), and the HTML artifact pages plus their coverage folder, which are
# regenerated from docs/artifacts/REGENERATION.md. REGENERATION.md and
# README.md in that folder ARE tracked (pre-M11 decision E-1).
graphify-out/
docs/artifacts/*.html
docs/artifacts/coverage/

# Engine config a test once wrote into the repo root with this machine's
# absolute paths in it (pre-M11 N-4). Tests now use a temp stateDir; this
# stops a regression from being committed again.
/mcp-config.json
/claude-settings.json

# Claude Code's local state (tool-permission cache, subagent worktrees) is
# session/tooling-specific, not project source. Project skills are the
# exception: they are shared instructions every session on this repo uses.
.claude/*
!.claude/skills/
